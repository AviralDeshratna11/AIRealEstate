ENVIRONMENT=local
# Supabase pooled Postgres URI or local Postgres URL.
DATABASE_URL=

OPENAI_API_KEY=
# Leave OPENAI_BASE_URL unset to call api.openai.com directly with a real OpenAI key.
# To route through OpenRouter instead, set OPENAI_BASE_URL=https://openrouter.ai/api/v1,
# use an OpenRouter key, and vendor-prefix model ids (e.g. openai/gpt-4.1-mini).
# Note: OpenRouter has no embeddings endpoint, so embeddings always use GEMINI_API_KEY when set.
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# Free-tier friendly assistant + default embedding provider. Create a key in Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=
CALCOM_USERNAME=
CALCOM_EVENT_TYPE_SLUG=property-viewing
CALCOM_TIMEZONE=Asia/Kolkata

VAPI_WEBHOOK_SECRET=

ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_AGENT_PHONE_NUMBER_ID=
ELEVENLABS_WEBHOOK_SECRET=
ELEVENLABS_MODE=mock
ELEVENLABS_MAX_CALLS_PER_DAY=10
ELEVENLABS_MAX_CALL_SECONDS=240
ELEVENLABS_ALLOWED_CALL_START_HOUR=10
ELEVENLABS_ALLOWED_CALL_END_HOUR=19
ELEVENLABS_COOLDOWN_HOURS=24

WHATSAPP_PROVIDER=mock
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://*.vercel.app
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://*.vercel.app
NEXT_PUBLIC_API_URL=http://localhost:8000
# Use the public URL users open on every device. For mobile testing, do not use localhost;
# use a Vercel preview URL, ngrok URL, or LAN URL such as http://192.168.1.20:3000.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_AUTH_REDIRECT_URL=http://localhost:3000/auth/callback
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_AUTH_MOCK_MODE=true
# ElevenLabs agent id is not a secret - it's designed to be embedded client-side in the Convai widget.
# Leave unset to skip rendering the voice widget.
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Only set this if your project's Auth settings show "Legacy JWT Secret" as active (HS256).
# Projects on the newer asymmetric JWT Signing Keys (ES256/RS256 - check
# <SUPABASE_URL>/auth/v1/.well-known/jwks.json) must leave this empty: backend/app/auth/jwt.py
# only verifies HS256, so setting it would reject every real login. Leaving it empty falls
# through to a live REST check against Supabase instead, which works with either scheme.
SUPABASE_JWT_SECRET=
AUTH_PROVIDER=supabase
AUTH_MOCK_MODE=true
APP_ENV=development
